    <routeDistribution id="rd_-1.0.00_-3.0.00">  <!-- -1.0.00 → -3.0.00: 自由流所要時間の k 最短路(同じ交差点を2回通らない、最短の1.6倍まで) (k=2) を Kirchhoff 配分（k=3.5） -->
