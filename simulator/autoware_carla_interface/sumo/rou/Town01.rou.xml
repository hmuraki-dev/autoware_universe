<!-- 車両グループ A〜E の割合と入力台数を指定してランダムに車両を発生させるサンプル。
     vissim_fleet_vtypes.rou.xml と一緒に、この前に読み込むこと（車両グループの vType はそちらで定義）。
     carlavtypes.rou.xml も読み込む（CARLA から SUMO へ送る自車の vType はそちらで定義）。 -->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- 車両グループ。中身は Vissim の Town01.inpx の 2D/3D モデルと、車両タイプ内の割合と同じ
         (A_car=100 乗用車、B_truck=210 トラック、C_trailer=220 トレーラー(トラクター)、D_bus=300 バス、E_bike=700 バイク)。
         Co-Simulation/Sumo/util/make_vissim_fleet_vtypes.py で書き換える。グループどうしの比率は下の flow で決まる -->
    <vTypeDistribution id="A_car" vTypes="vissim.1.fiat_500 vissim.2.tesla_model_y vissim.3.volkswagen_golf vissim.4.mercedes_b_class vissim.5.mercedes_c_class vissim.6.skoda_superb_combi vissim.7.audi_a6_avant vissim.8.nissan_qashqai vissim.9.volkswagen_tiguan vissim.10.volkswagen_id_4" probabilities="0.06 0.05 0.18 0.11 0.14 0.05 0.11 0.07 0.18 0.05"/>
    <vTypeDistribution id="B_truck" vTypes="vissim.23.delivery_daf_lf" probabilities="1"/>
    <vTypeDistribution id="C_trailer" vTypes="vissim.22.semi_tractor_volvo_e" probabilities="1"/>
    <vTypeDistribution id="D_bus" vTypes="vissim.31.c2_standard" probabilities="1"/>
    <vTypeDistribution id="E_bike" vTypes="vissim.70.motorbike_yamaha_mt_07" probabilities="1"/>

    <!-- 経路: duarouter（duaIterate）の均衡配分結果をもとに OD ごとに 4 ルートへ配分 -->
    <routeDistribution id="rd_-19.0.00_-18.0.00">  <!-- -19.0.00 → -18.0.00: duaIterate 019 の混雑時所要時間で Kirchhoff 配分（k=3.5） -->
        <route id="rd_-19.0.00_-18.0.00_0" edges="-19.0.00 6.0.00 24.0.00 23.0.00 22.0.00 -9.0.00 -10.0.00 -17.0.00 -18.0.00" probability="0.3454"/>  <!-- 所要時間 137 秒 -->
        <route id="rd_-19.0.00_-18.0.00_1" edges="-19.0.00 6.0.00 5.0.00 2.0.00 1.0.00 -16.0.00 -17.0.00 -18.0.00" probability="0.2672"/>  <!-- 所要時間 147 秒 -->
        <route id="rd_-19.0.00_-18.0.00_2" edges="-19.0.00 6.0.00 24.0.00 23.0.00 -4.0.00 -18.0.00" probability="0.2239"/>  <!-- 所要時間 155 秒 -->
        <route id="rd_-19.0.00_-18.0.00_3" edges="-19.0.00 6.0.00 24.0.00 23.0.00 22.0.00 21.0.00 2.0.00 1.0.00 -16.0.00 -17.0.00 -18.0.00" probability="0.1636"/>  <!-- 所要時間 170 秒 -->
    </routeDistribution>
    <routeDistribution id="rd_5.0.00_-18.0.00">  <!-- 5.0.00 → -18.0.00: duaIterate 019 の混雑時所要時間で Kirchhoff 配分（k=3.5） -->
        <route id="rd_5.0.00_-18.0.00_0" edges="5.0.00 2.0.00 1.0.00 -16.0.00 -17.0.00 -18.0.00" probability="0.4447"/>  <!-- 所要時間 88 秒 -->
        <route id="rd_5.0.00_-18.0.00_1" edges="5.0.00 -21.0.00 -9.0.00 -10.0.00 -17.0.00 -18.0.00" probability="0.2323"/>  <!-- 所要時間 106 秒 -->
        <route id="rd_5.0.00_-18.0.00_2" edges="5.0.00 2.0.00 -25.0.00 -10.0.00 -17.0.00 -18.0.00" probability="0.2311"/>  <!-- 所要時間 106 秒 -->
        <route id="rd_5.0.00_-18.0.00_3" edges="5.0.00 -21.0.00 -22.0.00 -4.0.00 -18.0.00" probability="0.0919"/>  <!-- 所要時間 138 秒 -->
    </routeDistribution>

    <!-- 追加経路: 自由流所要時間で求めた k 最短路を OD ごとに Kirchhoff 配分 -->
    <routeDistribution id="rd_-9.0.00_-19.0.00">  <!-- -9.0.00 → -19.0.00: 自由流所要時間の k 最短路(同じ交差点を2回通らない、最短の1.6倍まで) (k=3) を Kirchhoff 配分（k=3.5） -->
        <route id="rd_-9.0.00_-19.0.00_0" edges="-9.0.00 -10.0.00 -17.0.00 -18.0.00 -19.0.00" probability="0.5413"/>  <!-- 自由流所要時間 29 秒 -->
        <route id="rd_-9.0.00_-19.0.00_1" edges="-9.0.00 25.0.00 1.0.00 -16.0.00 -17.0.00 -18.0.00 -19.0.00" probability="0.3089"/>  <!-- 自由流所要時間 34 秒 -->
        <route id="rd_-9.0.00_-19.0.00_2" edges="-9.0.00 25.0.00 -2.0.00 -21.0.00 -22.0.00 -4.0.00 -18.0.00 -19.0.00" probability="0.1498"/>  <!-- 自由流所要時間 42 秒 -->
    </routeDistribution>
    <routeDistribution id="rd_19.0.00_-25.0.00">  <!-- 19.0.00 → -25.0.00: 自由流所要時間の k 最短路(同じ交差点を2回通らない、最短の1.6倍まで) (k=3) を Kirchhoff 配分（k=3.5） -->
        <route id="rd_19.0.00_-25.0.00_0" edges="19.0.00 18.0.00 17.0.00 16.0.00 -1.0.00 -25.0.00" probability="0.5261"/>  <!-- 自由流所要時間 31 秒 -->
        <route id="rd_19.0.00_-25.0.00_1" edges="19.0.00 18.0.00 4.0.00 22.0.00 21.0.00 2.0.00 -25.0.00" probability="0.2389"/>  <!-- 自由流所要時間 39 秒 -->
        <route id="rd_19.0.00_-25.0.00_2" edges="19.0.00 12.0.00 23.0.00 22.0.00 21.0.00 2.0.00 -25.0.00" probability="0.2350"/>  <!-- 自由流所要時間 39 秒 -->
