    <routeDistribution id="rd_10.0.00_-24.0.00">  <!-- 10.0.00 → -24.0.00: 自由流所要時間の k 最短路(同じ交差点を2回通らない、最短の1.6倍まで) (k=2) を Kirchhoff 配分（k=3.5） -->
        <route id="rd_10.0.00_-24.0.00_0" edges="10.0.00 9.0.00 -22.0.00 -23.0.00 -24.0.00" probability="0.6347"/>  <!-- 自由流所要時間 29 秒 -->
        <route id="rd_10.0.00_-24.0.00_1" edges="10.0.00 25.0.00 -2.0.00 -21.0.00 -22.0.00 -23.0.00 -24.0.00" probability="0.3653"/>  <!-- 自由流所要時間 34 秒 -->
    </routeDistribution>
    <routeDistribution id="rd_-18.0.00_-2.0.00">  <!-- -18.0.00 → -2.0.00: 自由流所要時間の k 最短路(同じ交差点を2回通らない、最短の1.6倍まで) (k=2) を Kirchhoff 配分（k=3.5） -->
        <route id="rd_-18.0.00_-2.0.00_0" edges="-18.0.00 12.0.00 23.0.00 22.0.00 -9.0.00 25.0.00 -2.0.00" probability="0.7854"/>  <!-- 自由流所要時間 35 秒 -->
        <route id="rd_-18.0.00_-2.0.00_1" edges="-18.0.00 -19.0.00 6.0.00 24.0.00 23.0.00 22.0.00 -9.0.00 25.0.00 -2.0.00" probability="0.2146"/>  <!-- 自由流所要時間 50 秒 -->
