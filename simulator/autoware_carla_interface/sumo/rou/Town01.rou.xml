        <route id="rd_24.0.00_-10.0.00_1" edges="24.0.00 23.0.00 22.0.00 21.0.00 2.0.00 -25.0.00 -10.0.00" probability="0.3653"/>  <!-- 自由流所要時間 34 秒 -->
    </routeDistribution>

    <!-- 入力1: -19.0.00 → -18.0.00
         入力台数 300 台/h(多様な経路の入力3〜10を追加したときに 600 から減らした)、グループ割合 A:B:C:D:E = 70:10:5:5:10
         グループごとの flow の台数 = 入力台数 × 割合。period="exp(台/h ÷ 3600)" でランダム（ポアソン）発生 -->
    <flow id="in1_A" type="A_car"     route="rd_-19.0.00_-18.0.00" begin="0" end="3600" period="exp(0.058333)" departLane="best" departSpeed="desired"/> <!-- 210 台/h -->
    <flow id="in1_B" type="B_truck"   route="rd_-19.0.00_-18.0.00" begin="0" end="3600" period="exp(0.008333)" departLane="best" departSpeed="desired"/> <!--  30 台/h -->
    <flow id="in1_C" type="C_trailer" route="rd_-19.0.00_-18.0.00" begin="0" end="3600" period="exp(0.004167)" departLane="best" departSpeed="desired"/> <!--  15 台/h -->
    <flow id="in1_D" type="D_bus"     route="rd_-19.0.00_-18.0.00" begin="0" end="3600" period="exp(0.004167)" departLane="best" departSpeed="desired"/> <!--  15 台/h -->
    <flow id="in1_E" type="E_bike"    route="rd_-19.0.00_-18.0.00" begin="0" end="3600" period="exp(0.008333)" departLane="best" departSpeed="desired"/> <!--  30 台/h -->

