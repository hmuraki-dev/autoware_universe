        <route id="rd_2.0.00_18.0.00_1" edges="2.0.00 1.0.00 0.0.00 -14.0.00 7.0.00 19.0.00 18.0.00" probability="0.1768"/>  <!-- 自由流所要時間 54 秒 -->
