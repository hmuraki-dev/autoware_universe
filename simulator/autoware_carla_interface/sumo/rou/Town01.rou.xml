    <routeDistribution id="rd_-8.0.00_10.0.00">  <!-- -8.0.00 → 10.0.00: 自由流所要時間の k 最短路(同じ交差点を2回通らない、最短の1.6倍まで) (k=1) を Kirchhoff 配分（k=3.5） -->
